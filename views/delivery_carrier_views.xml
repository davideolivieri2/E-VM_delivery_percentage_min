<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_carrier_form_percentage_min" model="ir.ui.view">
        <field name="name">delivery.carrier.form.percentage.min</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <field name="fixed_price" position="after">
                <field name="percentage_rate"
                        widget="percentage"
                        class="oe_inline"
                        invisible="delivery_type != 'percentage_min'"/>
                <field name="minimum_amount"
                        widget="monetary"
                        class="oe_inline"
                        invisible="delivery_type != 'percentage_min'"/>
            </field>
            <field name="margin" position="attributes">
                <attribute name="invisible">delivery_type in ('fixed', 'percentage_min')</attribute>
            </field>
            <field name="fixed_margin" position="attributes">
                <attribute name="invisible">delivery_type in ('fixed', 'percentage_min')</attribute>
            </field>
        </field>
    </record>
</odoo>
